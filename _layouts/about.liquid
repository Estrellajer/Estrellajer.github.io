---
layout: default
---
<style>
  .home-landing {
    --home-text: var(--global-text-color);
    --home-muted: #69717d;
    --home-soft: #8d96a3;
    --home-line: rgba(17, 19, 23, 0.1);
    --home-accent: #557a9f;
    --home-accent-soft: rgba(85, 122, 159, 0.12);
    padding-top: 1rem;
  }

  .home-landing a {
    color: inherit;
  }

  .home-landing a:hover {
    color: var(--home-accent);
    text-decoration: none;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.24fr) 332px;
    gap: 2rem;
    align-items: end;
    margin-bottom: 2.25rem;
  }

  .home-eyebrow {
    margin-bottom: 1rem;
    color: var(--home-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .home-title {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 600;
    color: var(--home-text);
  }

  .home-subtitle {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--home-muted);
  }

  .home-intro {
    margin-top: 1.25rem;
    max-width: 48rem;
    color: var(--home-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .home-intro p:last-child {
    margin-bottom: 0;
  }

  .home-portrait-wrap {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    border-left: 1px solid var(--home-line);
    padding-left: 1.4rem;
  }

  .home-portrait {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1.6rem;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.05);
  }

  .home-portrait-quote {
    margin-top: 0.8rem;
    color: var(--home-soft);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .home-side-block {
    margin-top: 1rem;
  }

  .home-research {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.58rem;
  }

  .home-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.5rem;
    padding: 0.38rem 0.78rem;
    border: 1px solid rgba(85, 122, 159, 0.12);
    border-radius: 0.86rem;
    background: linear-gradient(180deg, rgba(85, 122, 159, 0.12), rgba(85, 122, 159, 0.07));
    color: #496885;
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }

  .home-section {
    margin-top: 2.25rem;
  }

  .home-section-title {
    margin: 0 0 1.1rem;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--home-text);
  }

  .home-news-list,
  .home-meta-list {
    display: grid;
    gap: 1rem;
  }

  .home-news-item,
  .home-meta-item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .home-news-date,
  .home-meta-label {
    color: var(--home-soft);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: 0.25rem;
  }

  .home-news-copy,
  .home-meta-copy {
    margin: 0;
    color: var(--home-muted);
    line-height: 1.8;
    font-size: 1rem;
  }

  .home-publications .publications {
    margin-top: 0;
  }

  .home-publications .publications ol.bibliography {
    margin-bottom: 0;
  }

  .home-publications .publications ol.bibliography li {
    margin-bottom: 1.15rem;
    padding: 0.78rem 0.95rem;
    border: 1px solid rgba(85, 122, 159, 0.14);
    border-radius: 1.1rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 250, 253, 0.98)), var(--global-card-bg-color);
    box-shadow: 0 12px 30px rgba(16, 24, 40, 0.06);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .home-publications .publications ol.bibliography li:hover {
    transform: translateY(-2px);
    border-color: rgba(85, 122, 159, 0.22);
    box-shadow: 0 18px 36px rgba(16, 24, 40, 0.09);
  }

  .home-publications .publications .row {
    display: grid !important;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 1rem;
    margin: 0;
    align-items: stretch;
  }

  .home-publications .publications .abbr,
  .home-publications .publications [class*='col-sm-'],
  .home-publications .publications [class^='col-sm-'] {
    max-width: none;
    flex: none;
    padding: 0;
  }

  .home-publications .publications .abbr {
    margin-bottom: 0;
    height: 100%;
  }

  .home-publications .publications .publication-preview figure {
    margin-bottom: 0;
  }

  .home-publications .publications .publication-copy {
    display: flex;
    flex-direction: column;
  }

  .home-publications .publications .publication-copy .links {
    margin-top: auto;
  }

  .home-publications .publications .publication-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.28rem;
  }

  .home-publications .publications .publication-tag,
  .home-publications .publications .publication-meta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    min-height: 1.5rem;
    padding: 0.16rem 0.52rem;
    border: 1px solid rgba(63, 97, 137, 0.16);
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.2;
    text-decoration: none !important;
    text-transform: uppercase;
  }

  .home-publications .publications .publication-tag {
    background: linear-gradient(180deg, rgba(85, 122, 159, 0.11), rgba(85, 122, 159, 0.07));
    color: #315578 !important;
  }

  .home-publications .publications .publication-meta-link {
    background: rgba(17, 19, 23, 0.035);
    color: var(--home-soft) !important;
  }

  .home-publications .publications .publication-tag:hover {
    color: #254869 !important;
    border-color: rgba(63, 97, 137, 0.24);
    background: linear-gradient(180deg, rgba(85, 122, 159, 0.16), rgba(85, 122, 159, 0.09));
  }

  .home-publications .publications .publication-meta-link:hover {
    color: var(--home-muted) !important;
    border-color: rgba(63, 97, 137, 0.2);
    background: rgba(17, 19, 23, 0.06);
  }

  .home-publications .publications .publication-preview {
    overflow: hidden;
    border-radius: 0.75rem;
    height: 100%;
  }

  .home-publications .publications .publication-preview,
  .home-publications .publications .publication-preview figure,
  .home-publications .publications .publication-preview picture {
    display: block;
    margin: 0;
  }

  .home-publications .publications .publication-preview figure,
  .home-publications .publications .publication-preview picture,
  .home-publications .publications .publication-preview img.preview,
  .home-publications .publications .publication-preview .preview {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0;
    object-fit: cover;
    border-radius: 0.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .home-publications .publications .publication-media-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 6rem;
    border-radius: 0.75rem;
    background: repeating-linear-gradient(
        -45deg,
        rgba(85, 122, 159, 0.05),
        rgba(85, 122, 159, 0.05) 10px,
        rgba(255, 255, 255, 0.72) 10px,
        rgba(255, 255, 255, 0.72) 20px
      ),
      linear-gradient(180deg, #f9fbfd 0%, #eef3f8 100%);
  }

  .home-publications .publications .publication-media-fallback-mark {
    color: var(--home-soft);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-publications .publications .title {
    color: var(--home-text);
    font-size: 1.12rem;
    line-height: 1.3;
    margin-bottom: 0.24rem;
    font-weight: 600;
  }

  .home-publications .publications .author,
  .home-publications .publications .links {
    color: var(--home-muted);
  }

  .home-publications .publications .author,
  .home-publications .publications .periodical {
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .home-publications .publications .periodical {
    color: var(--home-soft);
    margin-top: 0.12rem;
  }

  .home-publications .publications .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
    margin-top: 0.55rem;
    padding-top: 0;
  }

  .home-publications .publications .links a.btn {
    border: 1px solid rgba(85, 122, 159, 0.16);
    border-radius: 999px;
    background: rgba(85, 122, 159, 0.06);
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    line-height: 1.2;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .home-publications .publications .links a.btn:hover {
    background: rgba(85, 122, 159, 0.12);
    border-color: rgba(85, 122, 159, 0.28);
  }

  @media (max-width: 900px) {
    .home-hero,
    .home-news-item,
    .home-meta-item,
    .home-publications .publications .row {
      grid-template-columns: 1fr;
    }

    .home-portrait-wrap {
      border-left: 0;
      padding-left: 0;
      padding-top: 0.5rem;
    }

    .home-portrait {
      max-width: 420px;
    }
  }

  @media (max-width: 520px) {
    .home-research {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="home-landing">
  <section class="home-hero">
    <div>
      <div class="home-eyebrow">{{ page.hero_eyebrow }}</div>
      <h1 class="home-title">{{ page.hero_name }}</h1>
      <div class="home-subtitle">{{ page.hero_subtitle }}</div>
      <div class="home-intro">{{ content }}</div>
    </div>

    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <aside class="home-portrait-wrap">
        <img class="home-portrait" src="{{ profile_image_path | relative_url | bust_file_cache }}" alt="{{ page.hero_name }}">
        {% if page.photo_quote %}
          <div class="home-portrait-quote">{{ page.photo_quote }}</div>
        {% endif %}
        {% if page.research_areas %}
          <div class="home-side-block">
            <div class="home-research">
              {% for area in page.research_areas %}
                <span class="home-chip">{{ area }}</span>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </aside>
    {% endif %}
  </section>

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section">
      <h2 class="home-section-title">News</h2>
      <div class="home-news-list">
        {% assign news_items = site.news | reverse %}
        {% assign news_limit = page.announcements.limit | default: 3 %}
        {% for item in news_items limit: news_limit %}
          <article class="home-news-item">
            <div class="home-news-date">{{ item.date | date: '%b %Y' }}</div>
            <div class="home-news-copy">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section home-publications">
      <h2 class="home-section-title">Selected Publications</h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.awards %}
    <section class="home-section">
      <h2 class="home-section-title">Awards</h2>
      <div class="home-meta-list">
        {% for item in page.awards %}
          <article class="home-meta-item">
            <div class="home-meta-label">{{ item.label }}</div>
            <p class="home-meta-copy">{{ item.text }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if page.service %}
    <section class="home-section">
      <h2 class="home-section-title">Service</h2>
      <div class="home-meta-list">
        {% for item in page.service %}
          <article class="home-meta-item">
            <div class="home-meta-label">{{ item.label }}</div>
            <p class="home-meta-copy">{{ item.text }}</p>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>
