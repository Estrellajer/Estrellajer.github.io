---
layout: default
---
<div class="home-landing">
  <!-- Hero Section -->
  <section class="home-hero">
    <div class="home-hero-main">
      <div class="home-identity">
        <h1 class="home-title">
          {% if page.hero_name contains '「' %}
            {% assign name_parts = page.hero_name | split: '「' %}
            {{ name_parts[0] -}}
            <span class="name-zh">「{{ name_parts[1] }}</span>
          {% else %}
            {{ page.hero_name }}
          {% endif %}
        </h1>

        {% if page.hero_subtitle or page.hero_eyebrow %}
          <div class="home-subtitle">
            <span class="status-indicator"></span>
            <span class="subtitle-text">{{ page.hero_subtitle | default: page.hero_eyebrow }}</span>
          </div>
        {% endif %}
      </div>

      <div class="home-bio">
        {{ content }}
      </div>

      <!-- Quick Action CTAs (tightly clustered with bio) -->
      <div class="hero-actions">
        <a
          class="action-pill"
          href="https://github.com/Estrellajer"
          target="_blank"
          rel="external nofollow noopener"
          title="GitHub Profile"
        >
          <i class="fa-brands fa-github"></i>
          <span>GitHub</span>
        </a>
        <a
          class="action-pill"
          href="https://openreview.net/profile?id=%7EMaoqi_Liu2"
          target="_blank"
          rel="external nofollow noopener"
          title="OpenReview Profile"
        >
          <i class="ai ai-open-access"></i>
          <span>OpenReview</span>
        </a>
        <a
          class="action-pill"
          href="mailto:{{ site.email }}"
          title="Email Contact"
        >
          <i class="fa-regular fa-envelope"></i>
          <span>Email</span>
        </a>
        {% if site.cv_download_path %}
          <a
            class="action-pill"
            href="{{ site.cv_download_path | relative_url }}"
            download
            title="Download Curriculum Vitae"
          >
            <i class="fa-regular fa-file-lines"></i>
            <span>CV</span>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Right Profile Bento -->
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <aside class="home-profile-card">
        <div class="home-portrait-wrapper">
          <img
            class="home-portrait-img"
            src="{{ profile_image_path | relative_url | bust_file_cache }}"
            alt="{{ page.hero_name }}"
          >
        </div>
        {% if page.photo_quote %}
          <div class="home-quote-card">
            <i class="fa-solid fa-quote-left"></i>
            <span>{{ page.photo_quote }}</span>
          </div>
        {% endif %}
        {% if page.research_areas %}
          <div class="home-research-group">
            <span class="research-label">Research Focus</span>
            <div class="home-research-grid">
              {% for area in page.research_areas %}
                <span class="home-chip">{{ area }}</span>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </aside>
    {% endif %}
  </section>

  <!-- News Section -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section">
      <div class="section-head">
        <h2 class="home-section-title">
          <i class="ti ti-bell title-icon"></i>
          <span>News</span>
        </h2>
        <a class="section-more-link" href="{{ '/news/' | relative_url }}">
          <span>All news</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      <div class="home-news-stream">
        {% assign news_items = site.news | reverse %}
        {% assign news_limit = page.announcements.limit | default: 5 %}
        {% for item in news_items limit: news_limit %}
          <article class="home-news-row">
            <div class="news-date">{{ item.date | date: '%b %Y' }}</div>
            <div class="news-category">
              {% if item.category == 'paper' or item.content contains 'accepted' or item.content contains 'Paper' or item.content contains 'EMNLP' %}
                <span class="news-badge badge-paper">Paper</span>
              {% elsif item.category == 'intern'
                or item.title contains 'intern'
                or item.content contains 'intern'
                or item.content contains 'ByteDance'
              %}
                <span class="news-badge badge-intern">Intern</span>
              {% elsif item.category == 'grant' or item.title contains 'Qiyan' or item.title contains 'Grant' or item.content contains 'Grant' %}
                <span class="news-badge badge-grant">Award</span>
              {% else %}
                <span class="news-badge badge-general">News</span>
              {% endif %}
            </div>
            <div class="news-body">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Selected Publications Section -->
  {% if page.selected_papers %}
    <section class="home-section home-publications">
      <div class="section-head">
        <h2 class="home-section-title">
          <i class="ti ti-books title-icon"></i>
          <span>Selected Publications</span>
        </h2>
        <a class="section-more-link" href="{{ '/publications/' | relative_url }}">
          <span>All publications</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <!-- Awards Section -->
  {% if page.awards %}
    <section class="home-section">
      <div class="section-head">
        <h2 class="home-section-title">
          <i class="ti ti-award title-icon"></i>
          <span>Honors & Awards</span>
        </h2>
      </div>
      <div class="home-meta-grid">
        {% for item in page.awards %}
          <article class="home-meta-card">
            <div class="meta-period-badge">{{ item.label }}</div>
            <div class="meta-detail">{{ item.text }}</div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Experience Section -->
  {% if page.experience %}
    <section class="home-section">
      <div class="section-head">
        <h2 class="home-section-title">
          <i class="ti ti-briefcase title-icon"></i>
          <span>Experience</span>
        </h2>
      </div>
      <div class="home-meta-grid">
        {% for item in page.experience %}
          <article class="home-meta-card">
            <div class="meta-period-badge">{{ item.label }}</div>
            <div class="meta-detail">{{ item.text }}</div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- Academic Service Section -->
  {% if page.service %}
    <section class="home-section">
      <div class="section-head">
        <h2 class="home-section-title">
          <i class="ti ti-certificate title-icon"></i>
          <span>Academic Service</span>
        </h2>
      </div>
      <div class="home-meta-grid">
        {% for item in page.service %}
          <article class="home-meta-card">
            <div class="meta-period-badge">{{ item.label }}</div>
            <div class="meta-detail">{{ item.text }}</div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>
