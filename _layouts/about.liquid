---
layout: default
---
{% assign name_en = page.hero_name | split: '「' | first | strip %}
{% assign name_zh = page.hero_name | split: '「' | last | remove: '」' | strip %}
<div class="ed-home">
    {% assign side_img = page.profile.image | prepend: 'assets/img/' %}
    <aside class="vc-side">
      <div class="vc-side-inner">
        <img class="vc-avatar" src="{{ side_img | relative_url | bust_file_cache }}" alt="{{ name_en }}">
        <div class="vc-name">{{ name_en }}</div>
        <div class="vc-name-zh" lang="zh-CN">{{ name_zh }}</div>
        <p class="vc-role">{{ page.hero_subtitle | split: ' · ' | join: '<br>' }}</p>
        {% if page.research_areas %}
          <ul class="vc-tags">
            {% for area in page.research_areas %}<li>{{ area }}</li>{% endfor %}
          </ul>
        {% endif %}
        <ul class="vc-links">
          <li><a href="mailto:{{ site.email }}"><i class="fa-regular fa-envelope"></i>{{ site.email }}</a></li>
          <li><a href="https://github.com/Estrellajer" target="_blank" rel="external nofollow noopener"><i class="fa-brands fa-github"></i>GitHub</a></li>
          {% if site.cv_download_path %}
            <li><a href="{{ site.cv_download_path | relative_url }}" download><i class="fa-regular fa-file-lines"></i>CV (PDF)</a></li>
          {% endif %}
        </ul>
        {% if page.quote %}
          <figure class="vc-quote">
            {% if page.quote.zh %}<p class="vc-quote-zh" lang="zh-CN">{{ page.quote.zh }}</p>{% endif %}
            <blockquote>“{{ page.quote.text }}”</blockquote>
            <figcaption>— {{ page.quote.author }}</figcaption>
          </figure>
        {% endif %}
        {% if site.visitor_map %}
          <section class="vc-visitors" aria-label="Visitor map">
            <div class="vc-visitors-label">Visitors around the world</div>
            <div class="vc-visitors-map">
              <script id="_wauvm">var _wau = _wau || []; _wau.push(["map", "{{ site.visitor_map }}", "vm", "220", "110", "cart", "default-blue"]);</script>
              <script async src="https://waust.at/m.js"></script>
            </div>
            <a class="vc-visitors-link" href="https://whos.amung.us/stats/{{ site.visitor_map }}/" target="_blank" rel="external nofollow noopener">Visitor stats ↗</a>
          </section>
        {% endif %}
      </div>
    </aside>

  <section class="ed-hero">
    <div class="ed-bio">
      {{ content }}
    </div>
  </section>

  {% assign sec = 0 %}

  {% if page.announcements and page.announcements.enabled %}
    {% assign sec = sec | plus: 1 %}
    <section class="ed-section">
      <header class="ed-label">
        <span class="ed-num">0{{ sec }}</span>
        <h2>News</h2>
        <a class="ed-more" href="{{ '/news/' | relative_url }}">All news →</a>
      </header>
      <ol class="ed-rows">
        {% assign news_items = site.news | reverse %}
        {% assign news_limit = page.announcements.limit | default: 5 %}
        {% for item in news_items limit: news_limit %}
          <li class="ed-row">
            <time class="ed-when" datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %Y' }}</time>
            <div class="ed-what">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}

  {% if page.selected_papers %}
    {% assign sec = sec | plus: 1 %}
    <section class="ed-section ed-papers home-publications">
      <header class="ed-label">
        <span class="ed-num">0{{ sec }}</span>
        <h2>Selected Publications</h2>
        <a class="ed-more" href="{{ '/publications/' | relative_url }}">All publications →</a>
      </header>
      <div class="ed-body">
        {% include selected_papers.liquid %}
      </div>
    </section>
  {% endif %}

  {% assign meta_sections = 'awards,experience,service' | split: ',' %}
  {% for key in meta_sections %}
    {% assign entries = page[key] %}
    {% if entries %}
      {% assign sec = sec | plus: 1 %}
      <section class="ed-section">
        <header class="ed-label">
          <span class="ed-num">0{{ sec }}</span>
          <h2>
            {% case key %}
              {% when 'awards' %}Honors &amp; Awards
              {% when 'experience' %}Experience
              {% when 'service' %}Academic Service
            {% endcase %}
          </h2>
        </header>
        <ol class="ed-rows">
          {% for item in entries %}
            <li class="ed-row">
              <span class="ed-when">{{ item.label }}</span>
              <div class="ed-what">{{ item.text }}</div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}
  {% endfor %}
</div>
<script>
  document.querySelectorAll(".days-since").forEach((el) => {
    const days = Math.floor((Date.now() - Date.parse(el.dataset.since)) / 864e5);
    el.textContent = days.toLocaleString("en-US");
  });
</script>
<script>
  // Keep the sticky profile card fully reachable when it is taller than the viewport:
  // it sticks by its bottom edge instead of its top.
  (() => {
    const side = document.querySelector(".vc-side");
    const place = () => {
      side.style.top = Math.min(88, window.innerHeight - side.offsetHeight - 16) + "px";
    };
    place();
    window.addEventListener("resize", place);
    window.addEventListener("load", place);
  })();
</script>
