---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign url_beginning = page.url | slice: 0, 6 %}
{% assign has_outline = false %}
{% if content contains '<h1' or content contains '<h2' or content contains '<h3' or content contains '<h4' %}
  {% assign has_outline = true %}
{% endif %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .reading-page {
    --reading-text: var(--hl-text-primary);
    --reading-muted: var(--hl-text-muted);
    --reading-soft: var(--hl-text-soft);
    --reading-line: var(--hl-border);
    --reading-surface: var(--hl-surface);
    --reading-code-surface: var(--hl-surface-alt);
    --reading-accent: var(--hl-accent);
    --reading-accent-strong: var(--hl-accent-hover);
    --reading-accent-soft: var(--hl-accent-subtle);
    width: 100%;
    margin: 0 auto;
    padding-top: 1.5rem;
  }

  .reading-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: stretch;
    max-width: 1260px;
    width: 100%;
    margin: 0 auto;
  }

  .reading-shell--single {
    grid-template-columns: minmax(0, 960px);
    justify-content: center;
  }

  .reading-main {
    min-width: 0;
    max-width: 980px;
  }

  .reading-hero {
    margin-bottom: 2rem;
  }

  .reading-eyebrow {
    margin-bottom: 0.9rem;
    color: var(--reading-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .reading-title {
    margin: 0;
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    color: var(--reading-muted);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .reading-taxonomy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.65rem;
  }

  .reading-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0 0.88rem;
    border: 1px solid var(--reading-line);
    border-radius: 999px;
    background: var(--reading-accent-soft);
    color: var(--reading-accent);
    font-size: 0.88rem;
    font-weight: 520;
    text-decoration: none !important;
  }

  .reading-sidebar {
    min-width: 0;
    height: 100%;
  }

  .reading-sidebar[hidden] {
    display: none;
  }

  .reading-sidebar-inner {
    position: sticky;
    top: 5.5rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 0.5rem 1.4rem 1rem 0;
    border-right: 1px solid var(--reading-line);
    scrollbar-width: thin;
  }

  .reading-sidebar-label {
    margin-bottom: 0.8rem;
    color: var(--reading-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reading-toc,
  .reading-toc ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .reading-toc ul {
    display: grid;
    gap: 0.3rem;
  }

  .reading-toc > ul > li + li {
    margin-top: 0.4rem;
  }

  .reading-toc a {
    display: block;
    padding-left: 0.5rem;
    border-left: 2px solid transparent;
    color: var(--reading-muted);
    font-size: 0.94rem;
    line-height: 1.6;
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .reading-toc ul ul {
    margin-top: 0.35rem;
    padding-left: 0.95rem;
  }

  .reading-toc a:hover {
    color: var(--reading-accent);
    border-left-color: var(--reading-accent);
  }

  .reading-toc a.is-active {
    color: var(--reading-text);
    border-left-color: var(--reading-accent);
  }

  .reading-toc li[data-level='1'] > a {
    color: var(--reading-text);
    font-weight: 600;
  }

  .reading-toc li[data-level='2'] > a {
    font-size: 0.91rem;
  }

  .reading-toc li[data-level='3'] > a,
  .reading-toc li[data-level='4'] > a {
    color: var(--reading-soft);
    font-size: 0.86rem;
  }

  .reading-article,
  .reading-article #markdown-content {
    color: var(--reading-text);
    font-size: 1.08rem;
    line-height: 1.95;
  }

  .reading-article #markdown-content > p,
  .reading-article #markdown-content > ul,
  .reading-article #markdown-content > ol,
  .reading-article #markdown-content > blockquote,
  .reading-article #markdown-content > pre,
  .reading-article #markdown-content > figure,
  .reading-article #markdown-content > table,
  .reading-article #markdown-content > .table-responsive {
    margin-top: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .reading-article #markdown-content > :first-child {
    margin-top: 0;
  }

  .reading-article #markdown-content > * {
    max-width: 100%;
  }

  .reading-article img {
    max-width: 100%;
    height: auto;
    margin: 1.4rem 0;
    border-radius: 1rem;
  }

  .reading-article h1,
  .reading-article h2,
  .reading-article h3,
  .reading-article h4 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--reading-text);
    letter-spacing: 0;
    line-height: 1.34;
    scroll-margin-top: 6.5rem;
  }

  .reading-article [data-reading-level='1'] {
    margin-top: 3rem;
    padding-top: 0.2rem;
    padding-bottom: 0.68rem;
    border-bottom: 1px solid var(--reading-line);
    color: var(--reading-text);
    font-size: clamp(1.85rem, 2.15vw, 2.2rem);
    font-weight: 620;
    line-height: 1.28;
  }

  .reading-article [data-reading-level='2'] {
    margin-top: 2.7rem;
    color: var(--reading-text);
    font-size: clamp(1.35rem, 1.7vw, 1.55rem);
    font-weight: 620;
    line-height: 1.4;
  }

  .reading-article [data-reading-level='3'] {
    margin-top: 2.1rem;
    color: var(--reading-text);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .reading-article [data-reading-level='4'] {
    margin-top: 1.8rem;
    color: var(--reading-muted);
    font-size: 1.04rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .reading-article p {
    color: var(--reading-text);
  }

  .reading-article strong {
    color: var(--reading-text);
    font-weight: 650;
  }

  .reading-article blockquote {
    margin: 1.6rem 0;
    padding: 0.45rem 0 0.45rem 1.2rem;
    border-left: 2px solid var(--reading-accent);
    color: var(--reading-muted);
    background: var(--reading-accent-soft);
    border-radius: 0 0.75rem 0.75rem 0;
  }

  .reading-article ul,
  .reading-article ol {
    padding-left: 1.55rem;
  }

  .reading-article li + li {
    margin-top: 0.45rem;
  }

  .reading-article li::marker {
    color: var(--reading-accent);
  }

  /* Monospace Code Font Stack (System Native Monospace for 100% stable metrics) */
  .reading-article pre,
  .reading-article code,
  .reading-article kbd,
  .reading-article samp {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", "Fira Code", monospace !important;
  }

  /* Inline Code */
  .reading-article p code,
  .reading-article li code,
  .reading-article table code,
  .reading-article blockquote code {
    padding: 0.18rem 0.42rem;
    border: 1px solid var(--hl-code-border);
    border-radius: 0.38rem;
    background: var(--hl-inline-code-bg) !important;
    color: var(--hl-inline-code-text) !important;
    font-size: 0.86em;
    font-weight: 500;
    word-break: break-word;
  }

  /* Fenced Code Blocks & Rouge Containers */
  .reading-article .highlighter-rouge,
  .reading-article figure.highlight,
  .reading-article .highlight {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent !important;
    box-shadow: none;
  }

  .reading-article figure.highlight code,
  .reading-article div.highlighter-rouge code,
  .reading-article .highlighter-rouge .highlight code,
  .reading-article pre code {
    display: inline !important;
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent !important;
    color: inherit;
    font-family: inherit !important;
    font-size: inherit;
    line-height: inherit;
    white-space: inherit !important;
    tab-size: inherit !important;
    -moz-tab-size: inherit !important;
    letter-spacing: inherit !important;
  }

  /* MathJax Formula Typography */
  .reading-article mjx-container[display="true"] {
    display: block !important;
    margin: 1.6rem 0 !important;
    padding: 0.85rem 1rem !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    text-align: center !important;
    max-width: 100% !important;
    font-size: 1.05em !important;
    color: var(--reading-text) !important;
    scrollbar-width: thin;
    outline: none;
  }

  .reading-article mjx-container:not([display="true"]) {
    font-size: 1em !important;
    color: var(--reading-text) !important;
    vertical-align: -0.12em !important;
    margin: 0 0.1em;
    outline: none;
  }

  .reading-article hr {
    margin: 2.2rem 0;
    border: 0;
    border-top: 1px solid var(--reading-line);
  }

  .reading-article table {
    width: 100%;
    overflow: hidden;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--reading-line);
    border-radius: 0.95rem;
    background: var(--reading-surface);
  }

  .reading-article th,
  .reading-article td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--reading-line);
    text-align: left;
    vertical-align: top;
  }

  .reading-article th {
    color: var(--reading-text);
    font-weight: 650;
    background: var(--reading-accent-soft);
  }

  .reading-article tr:last-child td {
    border-bottom: 0;
  }

  .reading-article a {
    color: inherit;
    text-decoration-color: var(--reading-accent);
  }

  .reading-article a:hover {
    text-decoration-color: var(--reading-accent-strong);
  }

  .reading-related {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--reading-line);
  }

  .reading-related-title {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .reading-related-list {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .reading-related-item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .reading-related-item-title {
    font-weight: 600;
    line-height: 1.45;
  }

  .reading-related-item-meta {
    margin-top: 0.2rem;
    color: var(--reading-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 960px) {
    .reading-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .reading-main {
      order: 1;
      max-width: 100%;
    }

    .reading-sidebar {
      order: 2;
    }

    .reading-sidebar-inner {
      position: static;
      max-height: none;
      overflow-y: visible;
      padding: 1.2rem 0 0;
      border-right: 0;
      border-top: 1px solid var(--reading-line);
    }
  }
</style>

<div class="reading-page">
  <div class="reading-shell{% unless has_outline %} reading-shell--single{% endunless %}">
    {% if has_outline %}
      <aside class="reading-sidebar" data-reading-sidebar>
        <div class="reading-sidebar-inner">
          <div class="reading-sidebar-label">On This Page</div>
          <nav class="reading-toc" data-reading-toc></nav>
        </div>
      </aside>
    {% endif %}

    <div class="reading-main">
      <header class="reading-hero">
        <div class="reading-eyebrow">{% if url_beginning == '/blog/' %}Blog Post{% else %}Article{% endif %}</div>
        <h1 class="reading-title">{{ page.title }}</h1>
        <div class="reading-meta">
          <span>{{ page.date | date: '%B %d, %Y' }}</span>
          {% if page.author %}<span>{{ page.author }}</span>{% endif %}
          {% if page.last_updated %}<span>Updated {{ page.last_updated | date: '%B %d, %Y' }}</span>{% endif %}
          {% if page.meta %}<span>{{ page.meta }}</span>{% endif %}
        </div>
        <div class="reading-taxonomy">
          {% if url_beginning == '/blog/' %}
            <a class="reading-chip" href="{{ year | prepend: '/blog/' | relative_url }}">{{ year }}</a>
          {% else %}
            <span class="reading-chip">{{ year }}</span>
          {% endif %}
          {% for tag in page.tags %}
            {% if url_beginning == '/blog/' %}
              <a class="reading-chip" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
            {% else %}
              <span class="reading-chip">{{ tag }}</span>
            {% endif %}
          {% endfor %}
          {% for category in page.categories %}
            {% if url_beginning == '/blog/' %}
              <a class="reading-chip" href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>
            {% else %}
              <span class="reading-chip">{{ category }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </header>

      <article class="reading-article">
        <div id="markdown-content">
          {{ content }}
        </div>
      </article>

      {% if page.citation %}
        {% include citation.liquid %}
      {% endif %}

      {% if page.related_publications %}
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      {% endif %}

      {% assign related_items = page.related_posts %}
      {% if site.related_blog_posts and site.related_blog_posts.enabled and related_items and related_items != false and related_items.size > 0 %}
        <section class="reading-related">
          <h2 class="reading-related-title">Further Reading</h2>
          <ul class="reading-related-list">
            {% for related in related_items limit: 4 %}
              <li class="reading-related-item">
                <a href="{{ related.url | relative_url }}">
                  <div class="reading-related-item-title">{{ related.title }}</div>
                  <div class="reading-related-item-meta">
                    {{ related.date | date: '%b %d, %Y' }}
                    {% if related.description %} / {{ related.description }}{% endif %}
                  </div>
                </a>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  </div>

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

{% if has_outline %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const article = document.getElementById('markdown-content');
      const sidebar = document.querySelector('[data-reading-sidebar]');
      const toc = document.querySelector('[data-reading-toc]');

      if (!article || !sidebar || !toc) {
        return;
      }

      const headings = Array.from(article.querySelectorAll('h1, h2, h3, h4')).filter((heading) => {
        return heading.textContent && heading.textContent.trim().length > 0;
      });
      if (headings.length < 2) {
        sidebar.hidden = true;
        document.querySelector('.reading-shell')?.classList.add('reading-shell--single');
        return;
      }

      const rawLevels = [...new Set(headings.map((heading) => Number(heading.tagName.slice(1))))].sort((a, b) => a - b);
      const levelMap = new Map(rawLevels.map((level, index) => [level, index + 1]));
      const usedIds = new Map();

      const ensureUniqueId = (value, index) => {
        const base =
          String(value || '')
            .trim()
            .toLowerCase()
            .replace(/[^\p{Letter}\p{Number}\s-]/gu, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '') || `section-${index + 1}`;

        const count = usedIds.get(base) || 0;
        usedIds.set(base, count + 1);

        if (count === 0) {
          return base;
        }

        return `${base}-${count + 1}`;
      };

      headings.forEach((heading, index) => {
        heading.id = ensureUniqueId(heading.id || heading.textContent, index);

        const normalizedLevel = levelMap.get(Number(heading.tagName.slice(1))) || 1;
        heading.dataset.readingLevel = String(normalizedLevel);
      });

      const rootList = document.createElement('ul');
      const listStack = [rootList];
      let currentLevel = 1;

      headings.forEach((heading) => {
        const normalizedLevel = Number(heading.dataset.readingLevel || 1);

        while (currentLevel < normalizedLevel) {
          const parentList = listStack[listStack.length - 1];
          const lastItem = parentList.lastElementChild;

          if (!lastItem) {
            break;
          }

          const nestedList = document.createElement('ul');
          lastItem.appendChild(nestedList);
          listStack.push(nestedList);
          currentLevel += 1;
        }

        while (currentLevel > normalizedLevel) {
          listStack.pop();
          currentLevel -= 1;
        }

        const item = document.createElement('li');
        item.dataset.level = String(normalizedLevel);

        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        item.appendChild(link);
        listStack[listStack.length - 1].appendChild(item);
      });

      if (!rootList.children.length) {
        sidebar.hidden = true;
        document.querySelector('.reading-shell')?.classList.add('reading-shell--single');
        return;
      }

      toc.appendChild(rootList);

      const links = Array.from(toc.querySelectorAll('a'));
      const setActiveHeading = () => {
        const offset = 140;
        let currentHeading = headings[0];

        headings.forEach((heading) => {
          if (heading.getBoundingClientRect().top <= offset) {
            currentHeading = heading;
          }
        });

        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${currentHeading.id}`);
        });
      };

      setActiveHeading();
      document.addEventListener('scroll', setActiveHeading, { passive: true });
      window.addEventListener('resize', setActiveHeading);
    });
  </script>
{% endif %}
