---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign url_beginning = page.url | slice: 0, 6 %}
{% assign has_outline = false %}
{% if content contains '<h2' or content contains '<h3' %}
  {% assign has_outline = true %}
{% endif %}

{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .layout-post #navbar > .container {
    max-width: 1320px;
  }

  .layout-post .page-container {
    max-width: 1320px;
  }

  .reading-page {
    --reading-text: var(--global-text-color);
    --reading-muted: #69717d;
    --reading-soft: #8d96a3;
    --reading-accent: #557a9f;
    --reading-accent-soft: rgba(85, 122, 159, 0.12);
    width: min(100%, 78rem);
    margin: 0 auto;
    padding-top: 1rem;
  }

  .reading-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 2.25rem;
    align-items: start;
  }

  .reading-shell--single {
    grid-template-columns: minmax(0, 1fr);
    max-width: 62rem;
  }

  .reading-main {
    min-width: 0;
  }

  .reading-hero {
    margin-bottom: 2rem;
  }

  .reading-eyebrow {
    margin-bottom: 0.9rem;
    color: var(--reading-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .reading-title {
    margin: 0;
    font-size: clamp(2.45rem, 4.8vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    color: var(--reading-muted);
    font-size: 0.98rem;
    line-height: 1.8;
  }

  .reading-taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .reading-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0 0.92rem;
    border: 1px solid rgba(85, 122, 159, 0.12);
    border-radius: 999px;
    background: var(--reading-accent-soft);
    color: #496885;
    font-size: 0.9rem;
    text-decoration: none !important;
  }

  .reading-sidebar {
    min-width: 0;
  }

  .reading-sidebar[hidden] {
    display: none;
  }

  .reading-sidebar-inner {
    position: sticky;
    top: 6rem;
    padding: 1rem 0 0 1rem;
    border-left: 1px solid rgba(17, 19, 23, 0.08);
  }

  .reading-sidebar-label {
    margin-bottom: 0.8rem;
    color: var(--reading-soft);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reading-toc,
  .reading-toc ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .reading-toc ul {
    display: grid;
    gap: 0.3rem;
  }

  .reading-toc > ul > li + li {
    margin-top: 0.4rem;
  }

  .reading-toc a {
    display: block;
    color: var(--reading-muted);
    font-size: 0.94rem;
    line-height: 1.6;
    text-decoration: none;
  }

  .reading-toc ul ul {
    margin-top: 0.35rem;
    padding-left: 0.95rem;
  }

  .reading-toc a:hover {
    color: var(--reading-accent);
  }

  .reading-article,
  .reading-article #markdown-content {
    color: var(--reading-text);
    font-size: 1.1rem;
    line-height: 1.92;
  }

  .reading-article #markdown-content > :first-child {
    margin-top: 0;
  }

  .reading-article #markdown-content > * {
    max-width: 100%;
  }

  .reading-article img {
    margin: 1.4rem 0;
    border-radius: 1rem;
  }

  .reading-article h2,
  .reading-article h3,
  .reading-article h4 {
    margin-top: 2.2rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .reading-article h2 {
    font-size: 1.65rem;
  }

  .reading-article h3 {
    font-size: 1.3rem;
  }

  .reading-article blockquote {
    margin: 1.6rem 0;
    padding: 0.2rem 0 0.2rem 1.2rem;
    border-left: 2px solid rgba(85, 122, 159, 0.34);
    color: var(--reading-muted);
  }

  .reading-article ul,
  .reading-article ol {
    padding-left: 1.35rem;
  }

  .reading-article li + li {
    margin-top: 0.45rem;
  }

  .reading-article pre {
    margin: 1.4rem 0;
    border-radius: 1rem;
  }

  .reading-article a {
    color: inherit;
    text-decoration-color: rgba(85, 122, 159, 0.45);
  }

  .reading-article a:hover {
    text-decoration-color: rgba(85, 122, 159, 0.9);
  }

  .reading-related {
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(17, 19, 23, 0.08);
  }

  .reading-related-title {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .reading-related-list {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .reading-related-item a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .reading-related-item-title {
    font-weight: 600;
    line-height: 1.45;
  }

  .reading-related-item-meta {
    margin-top: 0.2rem;
    color: var(--reading-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 980px) {
    .reading-shell {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .reading-sidebar-inner {
      position: static;
      padding: 1rem 0 0;
      border-top: 1px solid rgba(17, 19, 23, 0.08);
      border-left: 0;
    }
  }
</style>

<div class="reading-page">
  <div class="reading-shell{% unless has_outline %} reading-shell--single{% endunless %}">
    <div class="reading-main">
      <header class="reading-hero">
        <div class="reading-eyebrow">{% if url_beginning == '/blog/' %}Blog Post{% else %}Article{% endif %}</div>
        <h1 class="reading-title">{{ page.title }}</h1>
        <div class="reading-meta">
          <span>{{ page.date | date: '%B %d, %Y' }}</span>
          {% if page.author %}<span>{{ page.author }}</span>{% endif %}
          {% if page.last_updated %}<span>Updated {{ page.last_updated | date: '%B %d, %Y' }}</span>{% endif %}
          {% if page.meta %}<span>{{ page.meta }}</span>{% endif %}
        </div>
        <div class="reading-taxonomy">
          {% if url_beginning == '/blog/' %}
            <a class="reading-chip" href="{{ year | prepend: '/blog/' | relative_url }}">{{ year }}</a>
          {% else %}
            <span class="reading-chip">{{ year }}</span>
          {% endif %}
          {% for tag in page.tags %}
            {% if url_beginning == '/blog/' %}
              <a class="reading-chip" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"># {{ tag }}</a>
            {% else %}
              <span class="reading-chip"># {{ tag }}</span>
            {% endif %}
          {% endfor %}
          {% for category in page.categories %}
            {% if url_beginning == '/blog/' %}
              <a class="reading-chip" href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>
            {% else %}
              <span class="reading-chip">{{ category }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </header>

      <article class="reading-article">
        <div id="markdown-content">
          {{ content }}
        </div>
      </article>

      {% if page.citation %}
        {% include citation.liquid %}
      {% endif %}

      {% if page.related_publications %}
        <h2>References</h2>
        <div class="publications">
          {% bibliography --group_by none --cited_in_order %}
        </div>
      {% endif %}

      {% assign related_items = page.related_posts %}
      {% if site.related_blog_posts and site.related_blog_posts.enabled and related_items and related_items != false and related_items.size > 0 %}
        <section class="reading-related">
          <h2 class="reading-related-title">Further Reading</h2>
          <ul class="reading-related-list">
            {% for related in related_items limit: 4 %}
              <li class="reading-related-item">
                <a href="{{ related.url | relative_url }}">
                  <div class="reading-related-item-title">{{ related.title }}</div>
                  <div class="reading-related-item-meta">
                    {{ related.date | date: '%b %d, %Y' }}
                    {% if related.description %} / {{ related.description }}{% endif %}
                  </div>
                </a>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>

    {% if has_outline %}
      <aside class="reading-sidebar" data-reading-sidebar>
        <div class="reading-sidebar-inner">
          <div class="reading-sidebar-label">On This Page</div>
          <nav class="reading-toc" data-reading-toc></nav>
        </div>
      </aside>
    {% endif %}
  </div>

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

{% if has_outline %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const article = document.getElementById('markdown-content');
      const sidebar = document.querySelector('[data-reading-sidebar]');
      const toc = document.querySelector('[data-reading-toc]');

      if (!article || !sidebar || !toc) {
        return;
      }

      const headings = Array.from(article.querySelectorAll('h2, h3'));
      if (!headings.length) {
        sidebar.hidden = true;
        return;
      }

      const slugify = (value, index) => {
        const slug = value
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-');
        return slug || `section-${index + 1}`;
      };

      const rootList = document.createElement('ul');
      let currentSection = null;

      headings.forEach((heading, index) => {
        if (!heading.id) {
          heading.id = slugify(heading.textContent, index);
        }

        if (heading.tagName === 'H2') {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent;
          item.appendChild(link);
          rootList.appendChild(item);
          currentSection = item;
          return;
        }

        if (!currentSection) {
          currentSection = document.createElement('li');
          rootList.appendChild(currentSection);
        }

        let nested = currentSection.querySelector('ul');
        if (!nested) {
          nested = document.createElement('ul');
          currentSection.appendChild(nested);
        }

        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        item.appendChild(link);
        nested.appendChild(item);
      });

      toc.appendChild(rootList);
    });
  </script>
{% endif %}
