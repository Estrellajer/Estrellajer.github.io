---
layout: default
---

{% assign archive_documents = page.documents | where_exp: "document", "document.hidden != true" %}
{% assign archive_title = page.title %}
{% assign archive_label = "Archive" %}
{% assign archive_description = "A collected set of posts." %}

{% if page.type == 'categories' %}
  {% assign archive_label = "Category" %}
  {% case page.title %}
    {% when "Research" %}
      {% assign archive_description = "Paper reading, research notes, and experiment logs." %}
    {% when "Engineering" %}
      {% assign archive_description = "Tooling, server setup, coding practice, and bug notes." %}
    {% when "Learning" %}
      {% assign archive_description = "Courses, interviews, algorithms, and deliberate practice." %}
    {% when "Life" %}
      {% assign archive_description = "Travel, conferences, reflections, and personal records." %}
    {% else %}
      {% assign archive_description = "Posts in this main category." %}
  {% endcase %}
{% elsif page.type == 'year' %}
  {% assign archive_label = "Year" %}
  {% assign archive_title = page.date | date: '%Y' %}
  {% assign archive_description = "Posts published in this year." %}
{% elsif page.type == 'tags' %}
  {% assign archive_label = "Tag" %}
  {% assign archive_description = "Posts tagged with this topic." %}
{% endif %}

<style>
  .archive-landing {
    padding-top: 1.2rem;
    padding-bottom: 3rem;
  }

  .archive-hero {
    margin-bottom: 2.5rem;
  }

  .archive-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .archive-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--hl-text-soft);
  }

  .archive-breadcrumb .crumb-link {
    color: var(--hl-text-muted);
    text-decoration: none !important;
    transition: color 0.18s ease;
  }

  .archive-breadcrumb .crumb-link:hover {
    color: var(--hl-accent);
  }

  .archive-breadcrumb .crumb-separator {
    color: var(--hl-border);
    font-size: 0.8rem;
    user-select: none;
  }

  .archive-breadcrumb .crumb-type {
    color: var(--hl-text-soft);
  }

  .archive-breadcrumb .crumb-current {
    color: var(--hl-accent);
    font-weight: 650;
  }

  .archive-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: var(--hl-surface);
    border: 1px solid var(--hl-border);
    color: var(--hl-text-muted);
    font-size: 0.83rem;
    font-weight: 550;
    text-decoration: none !important;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .archive-back-btn:hover {
    background: var(--hl-surface-hover);
    border-color: var(--hl-border-hover);
    color: var(--hl-accent);
    transform: translateX(-2px);
    box-shadow: 0 3px 8px rgba(15, 23, 42, 0.06);
  }

  .archive-count-badge {
    display: inline-block;
    margin-left: 0.45rem;
    padding: 0.12rem 0.55rem;
    border-radius: 9999px;
    background: var(--hl-accent-subtle);
    border: 1px solid var(--hl-accent-border);
    color: var(--hl-accent);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
    vertical-align: middle;
  }

  .archive-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    margin-top: 1.35rem;
  }

  .archive-topic-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.1rem;
    padding: 0.22rem 0.55rem 0.22rem 0.85rem;
    border-radius: 9999px;
    background: var(--hl-surface);
    border: 1px solid var(--hl-border);
    color: var(--hl-text-primary) !important;
    font-size: 0.84rem;
    font-weight: 550;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }

  .archive-topic-pill:hover {
    border-color: var(--hl-border-hover);
    color: var(--hl-accent) !important;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
  }

  .archive-topic-pill .pill-prefix {
    color: var(--hl-accent);
    font-weight: 700;
  }

  .archive-topic-pill .pill-icon {
    font-size: 0.76rem;
    color: var(--hl-accent);
  }

  .archive-topic-pill .pill-counter {
    display: inline-grid;
    place-items: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.38rem;
    border-radius: 9999px;
    background: var(--hl-accent-subtle);
    color: var(--hl-accent);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1;
  }

  .blog-item-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.65rem;
  }

  .blog-item-meta {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--hl-text-soft);
  }

  .blog-item-taxonomy,
  .blog-item-tags {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .archive-badge-cat,
  .archive-badge-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 550;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }

  .archive-badge-cat {
    background: var(--hl-surface-alt);
    border: 1px solid var(--hl-border);
    color: var(--hl-text-muted);
  }

  .archive-badge-cat:hover {
    background: var(--hl-accent-subtle);
    border-color: var(--hl-accent-border);
    color: var(--hl-accent);
  }

  .archive-badge-tag {
    background: transparent;
    border: 1px solid var(--hl-border);
    color: var(--hl-text-soft);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    font-size: 0.74rem;
  }

  .archive-badge-tag:hover {
    background: var(--hl-accent-subtle);
    border-color: var(--hl-accent-border);
    color: var(--hl-accent);
  }
</style>

<div class="blog-landing archive-landing">
  <!-- Top Navigation & Hero Section -->
  <section class="blog-hero archive-hero">
    <!-- Breadcrumbs & Quick Back Navigation -->
    <div class="archive-nav-bar">
      <nav class="archive-breadcrumb" aria-label="Breadcrumb">
        <a class="crumb-link" href="{{ '/blog/' | relative_url }}">Blog</a>
        <span class="crumb-separator">/</span>
        <span class="crumb-type">{{ archive_label }}</span>
        <span class="crumb-separator">/</span>
        <span class="crumb-current">{{ archive_title }}</span>
      </nav>

      <a class="archive-back-btn" href="{{ '/blog/' | relative_url }}">
        <i class="fa-solid fa-arrow-left"></i>
        <span>All Posts</span>
      </a>
    </div>

    <div class="blog-eyebrow">{{ archive_label }} Archive</div>
    <h1 class="blog-title">{{ archive_title }}</h1>
    <div class="blog-subtitle">
      {{ archive_description }}
      <span class="archive-count-badge">{{ archive_documents.size }} post{% unless archive_documents.size == 1 %}s{% endunless %}</span>
    </div>

    <!-- Related Topics / Tags / Categories Pills -->
    {% if page.type == 'categories' %}
      {% assign shown_tags = "" %}
      {% assign has_tags = false %}
      {% for document in archive_documents %}
        {% if document.tags.size > 0 %}
          {% assign has_tags = true %}
        {% endif %}
      {% endfor %}

      {% if has_tags %}
        <div class="archive-topics">
          {% for document in archive_documents %}
            {% for tag in document.tags %}
              {% assign tag_key = tag | prepend: "|" | append: "|" %}
              {% unless shown_tags contains tag_key %}
                {% assign tag_count = 0 %}
                {% for doc in archive_documents %}
                  {% if doc.tags contains tag %}
                    {% assign tag_count = tag_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
                <a class="archive-topic-pill" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">
                  <span class="pill-prefix">#</span>
                  <span>{{ tag }}</span>
                  <span class="pill-counter">{{ tag_count }}</span>
                </a>
                {% assign shown_tags = shown_tags | append: tag_key %}
              {% endunless %}
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}
    {% elsif page.type == 'tags' %}
      {% assign shown_cats = "" %}
      {% assign has_cats = false %}
      {% for document in archive_documents %}
        {% if document.categories.size > 0 %}
          {% assign has_cats = true %}
        {% endif %}
      {% endfor %}

      {% if has_cats %}
        <div class="archive-topics">
          {% for document in archive_documents %}
            {% for cat in document.categories %}
              {% assign cat_key = cat | prepend: "|" | append: "|" %}
              {% unless shown_cats contains cat_key %}
                {% assign cat_count = 0 %}
                {% for doc in archive_documents %}
                  {% if doc.categories contains cat %}
                    {% assign cat_count = cat_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
                <a class="archive-topic-pill" href="{{ cat | slugify | prepend: '/blog/category/' | relative_url }}">
                  <i class="fa-regular fa-folder pill-icon"></i>
                  <span>{{ cat }}</span>
                  <span class="pill-counter">{{ cat_count }}</span>
                </a>
                {% assign shown_cats = shown_cats | append: cat_key %}
              {% endunless %}
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </section>

  <!-- Modern Bento / Card List Layout -->
  <ul class="blog-list">
    {% for document in archive_documents %}
      {% if document.external_source == blank %}
        {% assign read_time = document.content | number_of_words | divided_by: 180 | plus: 1 %}
      {% else %}
        {% assign read_time = document.feed_content | strip_html | number_of_words | divided_by: 180 | plus: 1 %}
      {% endif %}

      <li class="blog-item">
        <div class="blog-item-grid{% if document.thumbnail %} blog-item-grid--with-thumb{% endif %}">
          <div>
            <div class="blog-item-date">{{ document.date | date: "%b %d, %Y" }}</div>

            {% if document.redirect == blank %}
              <a class="blog-item-title" href="{{ document.url | relative_url }}">{{ document.title }}</a>
            {% elsif document.redirect contains '://' %}
              <a class="blog-item-title" href="{{ document.redirect }}" target="_blank">{{ document.title }}</a>
            {% else %}
              <a class="blog-item-title" href="{{ document.redirect | relative_url }}">{{ document.title }}</a>
            {% endif %}

            {% if document.description %}
              <p class="blog-item-desc">{{ document.description }}</p>
            {% endif %}

            <div class="blog-item-footer">
              <span class="blog-item-meta">
                <i class="fa-regular fa-clock" style="margin-right: 0.3rem;"></i>
                {{ read_time }} min read
              </span>

              {% assign categories = document.categories | join: "" %}
              {% if categories != "" %}
                <span class="blog-item-taxonomy">
                  {% for category in document.categories %}
                    <a class="archive-badge-cat" href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">
                      <i class="fa-regular fa-folder" style="font-size: 0.72rem; margin-right: 0.25rem;"></i>{{ category }}
                    </a>
                  {% endfor %}
                </span>
              {% endif %}

              {% assign tags = document.tags | join: "" %}
              {% if tags != "" %}
                <span class="blog-item-tags">
                  {% for tag in document.tags %}
                    <a class="archive-badge-tag" href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">
                      #{{ tag }}
                    </a>
                  {% endfor %}
                </span>
              {% endif %}
            </div>
          </div>

          {% if document.thumbnail %}
            <div>
              <img class="blog-item-thumb" src="{{ document.thumbnail | relative_url }}" alt="{{ document.title }}">
            </div>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
</div>
