---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .content-page {
    --content-text: var(--hl-text-primary);
    --content-muted: var(--hl-text-muted);
    --content-soft: var(--hl-text-soft);
    --content-accent: var(--hl-accent);
    --content-line: var(--hl-border);
    padding-top: 1.5rem;
  }

  .content-page-hero {
    margin-bottom: 2.5rem;
  }

  .content-page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2rem;
    align-items: start;
  }

  .content-page-eyebrow {
    margin-bottom: 0.85rem;
    color: var(--content-accent);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .content-page-title {
    margin: 0;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 620;
    color: var(--content-text);
  }

  .content-page-description {
    margin-top: 0.85rem;
    max-width: 40rem;
    color: var(--content-muted);
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .content-page-article {
    color: var(--content-text);
    font-size: 1.03rem;
    line-height: 1.9;
  }

  .content-page-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .content-page-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.82rem;
    border: 1px solid rgba(61, 108, 140, 0.14);
    border-radius: 999px;
    background: rgba(61, 108, 140, 0.08);
    color: #3d6c8c;
    font-size: 0.86rem;
    font-weight: 520;
    text-decoration: none !important;
  }

  .content-page-visual {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    padding: 0.55rem;
    border: 1px solid var(--content-line);
    border-radius: 0.9rem;
    background: rgba(61, 108, 140, 0.05);
  }

  .content-page-article p:first-child {
    margin-top: 0;
  }

  .content-page-article h2,
  .content-page-article h3 {
    margin-top: 2rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .content-page-article a {
    color: var(--content-accent);
    text-decoration-color: rgba(61, 108, 140, 0.28);
    text-underline-offset: 0.2em;
  }

  .content-page-article a:hover {
    text-decoration-color: rgba(61, 108, 140, 0.7);
  }

  @media (max-width: 860px) {
    .content-page-hero-grid {
      grid-template-columns: 1fr;
    }

    .content-page-visual {
      max-width: 26rem;
    }
  }
</style>

<div class="content-page">
  <header class="content-page-hero">
    <div class="content-page-hero-grid">
      <div>
        <div class="content-page-eyebrow">{% if page.collection == 'projects' %}Project{% else %}Page{% endif %}</div>
        <h1 class="content-page-title">{{ page.title }}</h1>
        {% if page.description %}
          <p class="content-page-description">{{ page.description }}</p>
        {% endif %}
        {% if page.collection == 'projects' %}
          <div class="content-page-meta">
            {% if page.category %}
              <span class="content-page-chip">{{ page.category }}</span>
            {% endif %}
            {% if page.github %}
              <a class="content-page-chip" href="{{ page.github }}" rel="external nofollow noopener" target="_blank">GitHub</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if page.collection == 'projects' and page.img %}
        <div>
          <img class="content-page-visual" src="{{ page.img | relative_url }}" alt="{{ page.title }}">
        </div>
      {% endif %}
    </div>
  </header>

  <article class="content-page-article">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
