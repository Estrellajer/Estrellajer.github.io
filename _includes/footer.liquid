<style>
  .site-footer {
    border-top: 1px solid rgba(17, 19, 23, 0.08);
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    min-height: 4.25rem;
    color: #8d96a3;
    font-size: 0.92rem;
  }

  .site-footer__divider {
    width: 0.24rem;
    height: 0.24rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.45;
  }
</style>

{% if site.footer_fixed %}
  <footer class="site-footer fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div class="site-footer__inner">
        <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
        <span class="site-footer__divider"></span>
        <span>Research notes, publications, and selected projects.</span>
      </div>
    </div>
  </footer>
{% else %}
  <footer class="site-footer sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="site-footer__inner">
        <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
        <span class="site-footer__divider"></span>
        <span>Research notes, publications, and selected projects.</span>
        {% if site.last_updated %}
          <span class="site-footer__divider"></span>
          <span>Updated {{ 'now' | date: '%B %d, %Y' }}</span>
        {% endif %}
      </div>
    </div>
  </footer>
{% endif %}
