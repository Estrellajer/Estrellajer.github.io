
{% if site.footer_fixed %}
  <footer class="site-footer fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div class="site-footer__inner">
        <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
        <span class="site-footer__divider"></span>
        <span class="site-footer__quote"><em>Carpe diem · Seize the day</em></span>
      </div>
    </div>
  </footer>
{% else %}
  <footer class="site-footer sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="site-footer__inner">
        <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
        <span class="site-footer__divider"></span>
        <span class="site-footer__quote"><em>Carpe diem · Seize the day</em></span>
        {% if site.last_updated %}
          <span class="site-footer__divider"></span>
          <span>Updated {{ 'now' | date: '%B %d, %Y' }}</span>
        {% endif %}
      </div>
    </div>
  </footer>
{% endif %}
